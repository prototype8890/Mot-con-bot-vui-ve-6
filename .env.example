# === Ethereum RPC configuration ===
# Comma separated list, WebSocket endpoint should be first for realtime mempool access
RPC_URLS=wss://your-wss-provider,https://your-http-fallback

# === Telegram notifications (optional) ===
# Provide both token & chat id to receive alerts when a token passes all filters
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# === Signal filters ===
# Liquidity range (in ETH) to accept when LP is added
MIN_LP_ETH=0.5
MAX_LP_ETH=1.0

# Strict tax mode: keep at 0 to accept only zero tax tokens
STRICT_TAX_BPS_MAX=0
STRICT_TAX_MODE=reject_unknown

# Blocked selectors: comma separated names of functions that should not appear in the bytecode
BLOCKLIST_SELECTORS=setTax,blacklist

# Price guard configuration (set PRICE_GUARD=0 to disable)
PRICE_GUARD=1
PRICE_MULTIPLE_ABORT=3

# === Banana Gun auto-buy (optional) ===
# Provide all variables below to enable automatic orders via Banana Gun API
BANANA_GUN_API_URL=
BANANA_GUN_API_KEY=
BANANA_GUN_WALLET_ID=
BANANA_GUN_BUY_AMOUNT_ETH=0.1
BANANA_GUN_SLIPPAGE_BPS=500
BANANA_GUN_PRIORITY_FEE_GWEI=3
BANANA_GUN_GAS_MULTIPLIER=1.2
BANANA_GUN_AUTO_APPROVE=1
# BANANA_GUN_SOURCE=mempool_scanner
# BANANA_GUN_EXTRA_HEADERS={"x-api-version":"2024-01-01"}
