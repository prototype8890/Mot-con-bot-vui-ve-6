# === Ethereum RPC configuration ===
# Comma separated list, WebSocket endpoint should be first for realtime mempool access
RPC_URLS=wss://your-wss-provider,https://your-http-fallback

# === Telegram notifications (optional) ===
# Provide both token & chat id to receive alerts when a token passes all filters
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# === Signal filters ===
# Liquidity range (in ETH) to accept when LP is added
MIN_LP_ETH=0.5
MAX_LP_ETH=1.0

# Strict tax mode: keep at 0 to accept only zero tax tokens
STRICT_TAX_BPS_MAX=0
STRICT_TAX_MODE=reject_unknown

# Blocked selectors: comma separated names of functions that should not appear in the bytecode
BLOCKLIST_SELECTORS=setTax,blacklist

# Price guard configuration (set PRICE_GUARD=0 to disable)
PRICE_GUARD=1
PRICE_MULTIPLE_ABORT=3
AUTO_SELL_TIMEOUT_MINUTES=10
RUG_PULL_THRESHOLD_BPS=500
MAX_CONCURRENT_TRADES=3

# === Banana Gun automation via Telegram client (optional) ===
# Provide a Telegram API ID, hash and pre-generated StringSession to control the Banana Gun bot
# Learn how to create a StringSession: https://gram.js.org/getting-started/authorization
BANANA_GUN_TG_API_ID=
BANANA_GUN_TG_API_HASH=
BANANA_GUN_TG_SESSION=

# Telegram username or internal ID of the Banana Gun bot you want to control
# The default public bot is @BananaGunBot, update if you are using a private fork
BANANA_GUN_TG_BOT=@BananaGunBot

# Trading parameters used to render command templates
BANANA_GUN_BUY_AMOUNT_ETH=0.1
BANANA_GUN_SLIPPAGE_BPS=500
BANANA_GUN_PRIORITY_FEE_GWEI=3
BANANA_GUN_GAS_MULTIPLIER=1.2
BANANA_GUN_SELL_PERCENT=100

# Optional command templates. Available placeholders: {token}, {amount}, {slippageBps}, {priorityFeeGwei}, {gasMultiplier}, {percent}
BANANA_GUN_TG_BUY_TEMPLATE=/buy {token} {amount} {slippageBps} {priorityFeeGwei}
BANANA_GUN_TG_SELL_TEMPLATE=/sell {token} {percent}

# (Optional) Wallet address controlled by Banana Gun to help the bot track fills and settlements
BANANA_GUN_WALLET_ADDRESS=
